# ==============================================================================
# MD SAHADAT HOSSAIN - 3D PORTFOLIO ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Contact Receiver Email (Where client inquiries are sent)
VITE_CONTACT_RECEIVER_EMAIL="sahadat.info01@gmail.com"

# Backend Contact API Endpoint
# Default: "/api/contact" (handled by Vercel serverless function or Node backend)
VITE_CONTACT_API_ENDPOINT="/api/contact"

# Optional: Web3Forms Access Key (100% free direct email API fallback without server maintenance)
# Get a free key at: https://web3forms.com/ (Enter your email and copy the key)
VITE_WEB3FORMS_ACCESS_KEY=""

# Optional: Resend API Key (for serverless /api/contact email dispatch)
# Sign up at: https://resend.com/
RESEND_API_KEY=""

# Optional: Direct SMTP / Gmail App Password configuration (for custom Node server)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="sahadat.info01@gmail.com"
SMTP_PASS=""
